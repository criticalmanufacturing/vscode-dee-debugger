        "category": "DEE Debugger",
        "icon": "$(debug-alt)"
      },
      {
        "command": "deeDebugger.installVsdbg",
        "title": "Install vsdbg in Host Container",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.patchHostForDebugging",
        "title": "Patch Host for DEE Debugging (dev/test)…",
