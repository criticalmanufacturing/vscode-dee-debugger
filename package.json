      },
      {
        "command": "deeDebugger.syncUpload",
        "title": "Sync: Upload Local Changes to MES",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.syncDownload",
        "title": "Sync: Download Changes from MES",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.setCredentials",
        "title": "Set Credentials…",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.setAccessToken",
        "title": "Set Access Token…",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.setPersonalAccessToken",
        "title": "Set Personal Access Token…",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.clearCredentials",
        "title": "Clear Credentials",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.testConnection",
        "title": "Test Connection",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.expandAll",
