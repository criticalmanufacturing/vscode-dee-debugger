        "category": "DEE Debugger",
        "icon": "$(filter)"
      },
      {
        "command": "deeDebugger.searchActionsFiltered",
        "title": "Filter Actions (filter active)…",
        "category": "DEE Debugger",
        "icon": "$(filter-filled)"
      },
      {
        "command": "deeDebugger.syncCompare",
        "title": "Sync: Compare Local DEEs with MES",
        "category": "DEE Debugger",
