{
  "name": "dee-debugger",
  "displayName": "DEE Debugger for Critical Manufacturing MES",
  "description": "Browse, edit, sync and debug Critical Manufacturing MES DEE Actions and custom business code against a local or remote containerized host.",
  "version": "0.3.0",
  "publisher": "CriticalManufacturing",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/criticalmanufacturing/vscode-dee-debugger.git"
  },
  "homepage": "https://github.com/criticalmanufacturing/vscode-dee-debugger#readme",
  "bugs": {
    "url": "https://github.com/criticalmanufacturing/vscode-dee-debugger/issues"
  },
  "private": true,
  "engines": {
    "vscode": "^1.145.0"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "ms-dotnettools.csharp"
  ],
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Environment profiles define commands the extension executes (engineCommand)."
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deeDebugger",
          "title": "DEE Debugger",
          "icon": "resources/dee.svg"
        }
      ]
    },
    "views": {
      "deeDebugger": [
        {
          "id": "deeDebugger.explorer",
          "name": "DEE Explorer",
          "icon": "resources/dee.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deeDebugger.explorer",
        "when": "deeDebugger.connectionState == 'needs-credentials'",
        "contents": "Environment selected, but it has no stored credentials yet.\n[Set Credentials](command:deeDebugger.setCredentials)\nA Personal Access Token from the Security Portal user page is recommended; a browser-copied access token also works (expires after ~1 hour).\n[Switch Environment](command:deeDebugger.switchEnvironment)"
      },
      {
        "view": "deeDebugger.explorer",
        "when": "deeDebugger.connectionState == 'ready'",
        "contents": "Connected, but the DEE actions could not be loaded (or the MES has none).\n[Refresh](command:deeDebugger.refresh)\n[Show Output Log](command:deeDebugger.showOutput)\nIf the log shows a 401 or a login page, the token expired: [Set Credentials](command:deeDebugger.setCredentials). Wrong stack? [Switch Environment](command:deeDebugger.switchEnvironment)."
      },
      {
        "view": "deeDebugger.explorer",
        "when": "deeDebugger.connectionState != 'needs-credentials' && deeDebugger.connectionState != 'ready'",
        "contents": "Connect to a development or test MES to browse, edit and debug its DEE actions.\n[Discover Environments](command:deeDebugger.discoverEnvironments)\nFinds local Docker, docker-in-docker (devcontainer) and host-process stacks on this machine.\n[Add Environment Manually](command:deeDebugger.addEnvironment)\nFor remote Docker, Kubernetes/OpenShift or a custom engine command. You will be asked for credentials once connected.\n[Settings](command:workbench.action.openSettings?%5B%22deeDebugger%22%5D)\nNew here? [Open Getting Started](command:deeDebugger.openGettingStarted) walks through connect → open → debug in five steps."
      }
    ],
    "commands": [
      {
        "command": "deeDebugger.refresh",
        "title": "Refresh",
        "category": "DEE Debugger",
        "icon": "$(refresh)"
      },
      {
        "command": "deeDebugger.createAction",
        "title": "New DEE Action…",
        "category": "DEE Debugger",
        "icon": "$(add)"
      },
      {
        "command": "deeDebugger.openAction",
        "title": "Open DEE Action",
        "category": "DEE Debugger"
      },
      {
        "command": "deeDebugger.uploadAction",
        "title": "Save Action to MES (Compile & Save)",
        "category": "DEE Debugger",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "deeDebugger.reloadAction",
        "title": "Reload Action from MES",
        "category": "DEE Debugger",
        "icon": "$(discard)"
      },
      {
        "command": "deeDebugger.writeBackToSource",
        "title": "Write Code Back to Source File",
        "category": "DEE Debugger",
        "icon": "$(arrow-swap)"
      },
      {
