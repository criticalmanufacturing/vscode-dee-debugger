<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Target the LOWEST MES host runtime (MES 10 = .NET 6); framework-dependent + rollForward
         LatestMajor then runs the same build on .NET 6, 8 (MES 11) and 10 (MES 12) hosts. -->
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keep the build machine's paths out of the bundled DLL's PDB reference. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
