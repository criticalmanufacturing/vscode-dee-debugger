// Documentation container: build and preview the MkDocs Material site.
// Pick this from "Dev Containers: Reopen in Container" → "DEE Debugger — Docs (MkDocs)".
// Diagrams are pre-rendered to images at build time, so preview with a full build:
//   mkdocs build && (cd site && python -m http.server 8000 --bind 0.0.0.0)
// (`mkdocs serve` does NOT run the diagram-rendering plugin.)
{
  "name": "DEE Debugger — Docs (MkDocs)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    // Node + mermaid CLI (mmdc) for the mkdocs-mermaid-to-svg diagram pre-rendering.
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "yzhang.markdown-all-in-one",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "MkDocs preview", "onAutoForward": "openBrowserOnce" }
  },
  // mkdocs-material + glightbox + mermaid-to-svg (pip), and the mermaid CLI (npm) it shells out to.
  // Chromium libs for puppeteer come with the mermaid-cli install on this Debian base.
  "postCreateCommand": "pip install --user -r docs/requirements.txt && npm install -g @mermaid-js/mermaid-cli",
  "remoteUser": "vscode"
}
